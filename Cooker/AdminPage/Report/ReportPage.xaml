<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.Report.ReportPage"
			 xmlns:viewmodel="clr-namespace:Cooker.AdminPage.Report" x:DataType="viewmodel:ReportPageVM"      
			 xmlns:model="clr-namespace:Cooker.Models"
             Title="ReportPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to Reports"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

		<!--<StackLayout Orientation="Horizontal" Spacing="30">

			<StackLayout Orientation="Horizontal">
				<DatePicker Date="{Binding SelectedDate}" VerticalOptions="Fill" />
				<Button Text="Search"
                BackgroundColor="Red"
                Command="{Binding SearchCommand}" />
			</StackLayout>

			<StackLayout Orientation="Horizontal">
				<Label Text="Total" />
				<Label Text="{Binding LTotal}" TextColor="Red" />
			</StackLayout>

		</StackLayout>-->

		<Grid ColumnDefinitions="*,Auto">

			<!-- Left Side -->
			<StackLayout Grid.Column="0"
                 Orientation="Horizontal"
                 Spacing="5">

				<DatePicker Date="{Binding SelectedDate}"
                    VerticalOptions="Fill" />

				<Button Text="Search"
                BackgroundColor="Red"
                Command="{Binding SearchCommand}" />

			</StackLayout>

			<!-- Right Side -->
			<StackLayout Grid.Column="1"
                 Orientation="Horizontal"
                 Spacing="5"
                 VerticalOptions="Center">

				<Label Text="Total" />
				<Label Text="{Binding LTotal}"
               TextColor="Red" />

			</StackLayout>

		</Grid>



		<ListView Margin="40"  ItemsSource="{Binding LTotalOrder}" RowHeight="80">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="model:TotalOrder">
					<ViewCell>
						<Border>

							<Grid ColumnDefinitions="*,*,*" RowSpacing="20">
								<Label Grid.Column="0"  Text="{Binding ToBillNo}" VerticalOptions="Center" HorizontalOptions="Center"/>
								<Label Grid.Column="1" Text="{Binding ToTableNo}" VerticalOptions="Center" HorizontalOptions="Center"/>
								<Label Grid.Column="2"  Text="{Binding ToTotal}" VerticalOptions="Center" HorizontalOptions="Center"/>
							</Grid>
						</Border>

					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

	</VerticalStackLayout>
</ContentPage>