<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.LoginPage"
             Title="LoginPage">
	<Grid>
		<Image Source="loginpage.jpg" BackgroundColor="LightBlue" Aspect="Fill" />

		<Grid RowDefinitions="*,*,*" Margin="50,150"  >

			<StackLayout Grid.Row="0" Margin="10" >
				<Label Text="User Name" FontSize="Medium" FontAttributes="Bold" TextColor="White" />
				<Entry FontSize="Medium"  TextColor="Black" BackgroundColor="White" Placeholder="UserName" />
			</StackLayout>
			<StackLayout Grid.Row="1" Margin="10" >
				<Label Text="Password" FontSize="Medium" FontAttributes="Bold"  TextColor="White"/>
				<Entry FontSize="Medium"  TextColor="Black" BackgroundColor="White" Placeholder="Password" />
			</StackLayout>
			<StackLayout Grid.Row="2" Margin="10" >
				<Button x:Name="btnlogin" Text="Order Now"  BackgroundColor="Red" Clicked="btnlogin_Clicked"/>
			</StackLayout>
		</Grid>
	</Grid>
</ContentPage>