<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.GroupControls.AddEditGroupPage"
             Title="AddEditGroupPage"
			 xmlns:viewmodel="clr-namespace:Cooker.AdminPage.GroupControls" x:DataType="viewmodel:AddEditGroupPageVM" 
             xmlns:model="clr-namespace:Cooker.Models">

	<VerticalStackLayout Margin="20">
		<Label 
				Text="Welcome to Add Edit Group"
				VerticalOptions="Center" 
				HorizontalOptions="Center" />

		<Label Text="Group Name"/>
		<Entry Text="{Binding NGroup.Gname}"/>

		<Label Text="Image"/>
		<Entry Text="{Binding NGroup.Gimage}"/>

		<Image  BackgroundColor="Aqua"  Source ="{Binding NImage}" WidthRequest="500" HeightRequest="300" />

		<Button Command="{Binding SelectCommand}" Text="Select Image"/>


		<Button Text="Save" Command="{Binding SaveAddEditCommand}" BackgroundColor="red"/>

	</VerticalStackLayout>
</ContentPage>