<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.AdminPanel"
             Title="Admin Panel">
	<Grid>
		<Image Source="adminpanel.jpg"  Aspect="Fill" />

		<Grid RowDefinitions="auto,auto,auto,auto" Margin="50,200" RowSpacing="20" >
			<!--<Grid RowDefinitions="*,*,*,*" Margin="30,150" RowSpacing="20" >-->
			<Button Grid.Row="0"
					x:Name="AdminControl"
					Text="Admin Control"
					BackgroundColor="red"
					FontAttributes="Bold"
					FontSize="Medium"
					Clicked="AdminControl_Clicked"/>
					<!--IsVisible="false"-->
					
			<Button Grid.Row="1"
					x:Name="ItemControl"	
					Text="Item Control"
					BackgroundColor="red"
					FontAttributes="Bold"
					FontSize="Medium"
					Clicked="ItemControl_Clicked"/>
			<Button Grid.Row="2"
					x:Name="OrderControl"	
					Text="Order Control"
					BackgroundColor="red"
					FontAttributes="Bold"
					FontSize="Medium"
					Clicked="OrderControl_Clicked"/>
			<Button Grid.Row="3"
					x:Name="Report"
					Text="Report"
					BackgroundColor="red"
					FontAttributes="Bold"
					FontSize="Medium"
					Clicked="Report_Clicked"/>

		</Grid>
	</Grid>
</ContentPage>