<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.AdminControls.AddEditUserPage"
			 xmlns:viewmodel="clr-namespace:Cooker.AdminPage.AdminControls" x:DataType="viewmodel:AddEditUserPageVM" 
			 xmlns:model="clr-namespace:Cooker.Models"
             Title="Add/Edit User Page">

	<VerticalStackLayout Margin="20" Spacing="10">
		<Label 
            Text="Welcome to Add User"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
		<Label Text="Employee Name"/>
		<Entry Text="{Binding NUser.EmployeeName}"/>

		<Label Text="User Name"/>
		<Entry Text="{Binding NUser.UserName}"/>

		<Label Text="Pass"/>
		<Entry Text="{Binding NUser.Pass}"/>

		<ListView  ItemsSource="{Binding LUserRole}" HeightRequest="100" BackgroundColor="LightGray">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="model:UserRolesName">
					<ViewCell>
						<Grid ColumnDefinitions="*,*">
							<!--<Grid ColumnDefinitions="*,*,*,*">-->
							<Label Grid.Column="0" Text="{Binding RoleName}"/>
							<!--<Label Grid.Column="1" Text="{Binding UserId}"/>
							<Label Grid.Column="2" Text="{Binding RoleId}"/>-->

							<ImageButton Grid.Column="3"
                                   Source="delete.png"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" 
                                   WidthRequest="25"
                                   HeightRequest="25"
                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AddEditUserPageVM}},Path=DeleteRoleCommand }" 
                                   CommandParameter="{Binding Id}"/>

						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<StackLayout Orientation="Horizontal" Spacing="20" >

			<Picker x:Name="picker"
				Title="Select a Role"
				ItemsSource="{Binding LRole}"
				ItemDisplayBinding="{Binding RoleName}" 
				SelectedItem="{Binding SelectedRole}">
			</Picker>

			<Button Text="Add Role" Command="{Binding AddRoleCommand}"  BackgroundColor="red"/>
		</StackLayout>

		<Button Text="Save" Command="{Binding SaveAddEditCommand}" BackgroundColor="red"/>

	</VerticalStackLayout>
</ContentPage>