<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.AdminControls.AddEditUserPage"
			 xmlns:viewmodel="clr-namespace:Cooker.AdminPage.AdminControls" x:DataType="viewmodel:AddEditUserPageVM" 
             Title="Add/Edit User Page">

	<VerticalStackLayout Margin="20" Spacing="10">
		<Label 
            Text="Welcome to Add User"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
		<Label Text="Employee Name"/>
		<Entry Text="{Binding NUser.EmployeeName}"/>

		<Label Text="User Name"/>
		<Entry Text="{Binding NUser.UserName}"/>

		<Label Text="Pass"/>
		<Entry Text="{Binding NUser.Pass}"/>

		<Button Text="Save" Command="{Binding SaveAddEditCommand}" BackgroundColor="red"/>

	</VerticalStackLayout>
</ContentPage>