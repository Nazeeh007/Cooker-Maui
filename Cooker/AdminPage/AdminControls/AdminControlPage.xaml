<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.AdminControls.AdminControlPage"
			 xmlns:viewmodel="clr-namespace:Cooker.AdminPage.AdminControls" x:DataType="viewmodel:AdminControlPageVM"      
			 xmlns:model="clr-namespace:Cooker.Models"
             Title="Admin Control Page">
	<Grid >
		<!--<Image Source="bg2.jpg" Aspect="Fill" />-->

		<Grid RowDefinitions="auto,auto,*" Padding="20" RowSpacing="20">
			<Label 
                Text="Welcome to User Control"
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                FontSize="Small"
                />

			<Button Text="Add User" Command="{Binding AddCommand}" BackgroundColor="red" Grid.Row="1" />

			<ListView  Grid.Row="2" ItemsSource="{Binding LUserPass}">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="model:UserPass">
						<ViewCell>
							<Grid ColumnDefinitions="*,*,*,*,*,*,*">
								<Label Grid.Column="0" Text="{Binding Id}"/>
								<Label Grid.Column="1" Text="{Binding UserName}"/>
								<Label Grid.Column="2" Text="{Binding EmployeeName}"/>
								<Label Grid.Column="3" Text="{Binding UserStatus}"/>
								<ImageButton Grid.Column="4"
                                             Source="edit.png"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" 
                                             WidthRequest="25"
                                             HeightRequest="25"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AdminControlPageVM}},Path=EditCommand }" 
                                             CommandParameter="{Binding Id}"/>
								<ImageButton Grid.Column="6"
                                            Source="delete.png"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" 
                                            WidthRequest="25"
                                            HeightRequest="25"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AdminControlPageVM}},Path=StopCommand }" 
                                            CommandParameter="{Binding Id}"/>
								<ImageButton Grid.Column="5"
                                            Source="active.png"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" 
                                            WidthRequest="25"
                                            HeightRequest="25"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:AdminControlPageVM}},Path=StartCommand }" 
                                            CommandParameter="{Binding Id}"/>
							</Grid>
						</ViewCell>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

		</Grid>

	</Grid>
</ContentPage>