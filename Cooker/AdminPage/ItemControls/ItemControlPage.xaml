<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.ItemControls.ItemControlPage"
			 xmlns:viewmodel="clr-namespace:Cooker.AdminPage.ItemControls" x:DataType="viewmodel:ItemControlPageVM"      
			 xmlns:model="clr-namespace:Cooker.Models"
             Title="ItemControlPage">
	<VerticalStackLayout Margin="10" Spacing="10">
		<Button Text="Add Item"  BackgroundColor="red" Command="{Binding AddCommand}"/>

		<ListView  ItemsSource="{Binding LItems}">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="model:Item">
					<ViewCell>
						<Grid ColumnDefinitions="*,150,*,*,*,*,*">
							<Label Grid.Column="0" Text="{Binding ItmName}"/>
							<Label Grid.Column="1" Text="{Binding ItmDesc}"/>
							<Label Grid.Column="2" Text="{Binding ItmPrice}"/>
							<Image Grid.Column="3" Source="{Binding ItmImage}" WidthRequest="100" HeightRequest="100"/>
							<ImageButton Grid.Column="4"
							  Source="edit.png"
							  HorizontalOptions="Center"
							  VerticalOptions="Center" 
							  WidthRequest="25"
							  HeightRequest="25"
							  Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ItemControlPageVM}},Path=EditCommand }" 
							  CommandParameter="{Binding Id}"/>
							<ImageButton Grid.Column="5"
							 Source="delete.png"
							 HorizontalOptions="Center"
							 VerticalOptions="Center" 
							 WidthRequest="25"
							 HeightRequest="25"
							 Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ItemControlPageVM}},Path=StopCommand }" 
							 CommandParameter="{Binding Id}"/>
							<ImageButton Grid.Column="6"
							 Source="active.png"
							 HorizontalOptions="Center"
							 VerticalOptions="Center" 
							 WidthRequest="25"
							 HeightRequest="25"
							 Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:ItemControlPageVM}},Path=StartCommand }" 
							 CommandParameter="{Binding Id}"/>
						</Grid>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</VerticalStackLayout>
</ContentPage>