<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.AdminPage.ItemControls.AddEditItemPage"
             Title="AddEditItemPage"
			 xmlns:viewmodel="clr-namespace:Cooker.AdminPage.ItemControls" x:DataType="viewmodel:AddEditItemPageVM" 
             xmlns:model="clr-namespace:Cooker.Models">

	<VerticalStackLayout Margin="20" Spacing="5">
		<Label 
				Text="Welcome to Add Edit Item"
				VerticalOptions="Center" 
				HorizontalOptions="Center" />

		<Label Text="Item Name"/>
		<Entry Text="{Binding NItem.ItmName }"/>

		<Label Text="Item Description"/>
		<Entry Text="{Binding NItem.ItmDesc }"/>
		
		<Label Text="Item Price"/>
		<Entry Text="{Binding NItem.ItmPrice }"/>

		<Label Text="Item Group"/>
		<!--<Entry Text="{Binding NItem.Gid }"/>-->
		<!--<Picker WidthRequest="300" 
				ItemsSource="{Binding LGroup}" 
				ItemDisplayBinding="{Binding Gname}" 
				SelectedItem="{Binding SelectedGroup}"
				SelectedIndex="{Binding Index}" />-->
		<Picker
			WidthRequest="300"
			ItemsSource="{Binding LGroup}"
			ItemDisplayBinding="{Binding Gname, x:DataType=model:Group}"
			SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
			SelectedIndex="{Binding Index}"/>


		<Label Text="Image"/>
		<Image  BackgroundColor="Aqua"  Source ="{Binding NImage}" WidthRequest="300" HeightRequest="200" />
		<StackLayout Spacing="20">

			<StackLayout Spacing="5">
				<Button Command="{Binding SelectCommand}" Text="Select Image"/>


				<Button Text="Save" Command="{Binding SaveAddEditCommand}" BackgroundColor="red"/>
			</StackLayout>

			<Button Text="Exit" Command="{Binding ExitCommand}" BackgroundColor="red"/>
		</StackLayout>


	</VerticalStackLayout>
</ContentPage>