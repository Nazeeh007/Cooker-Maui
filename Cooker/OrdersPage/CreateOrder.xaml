<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.OrdersPage.CreateOrder"
			 xmlns:viewmodel="clr-namespace:Cooker.OrdersPage" x:DataType="viewmodel:CreateOrderVM"      
             xmlns:model="clr-namespace:Cooker.Models"
             Title="CreateOrder">
    <VerticalStackLayout>
		<StackLayout Orientation="Horizontal" Margin="10" Spacing="50" HorizontalOptions="Center" VerticalOptions="Center">
			<Label 
				Text="Welcome to Groups"
				VerticalOptions="Center" 
				HorizontalOptions="Center" />
			<StackLayout Orientation="Horizontal">
				<Label 
					Text="Table Number: "
					VerticalOptions="Center" 
					HorizontalOptions="Center" />
				<Label 
					Text="{Binding TableNo}"
					VerticalOptions="Center" 
					HorizontalOptions="Center" 
					TextColor="Blue"/>
			</StackLayout>
		</StackLayout> 

		<Border Margin="10" HeightRequest="50" >
			<Grid ColumnDefinitions="*,*,*,*" >
				<StackLayout Grid.Column="0" Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="Center">
					<Label Text="Bill Number : " />
					<Label Text="{Binding OHeader.BillNo}" TextColor="Red" />
				</StackLayout>
				
				<StackLayout Grid.Column="1" Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="Center">
					<Label Text="Order Item Count : " />
					<Label Text="{Binding OHeader.CCount}" TextColor="Red" />
				</StackLayout>

				<StackLayout Grid.Column="2" Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="Center">
					<Label Text="Total Order : " />
					<Label Text="{Binding OHeader.Total}" TextColor="Red" />
				</StackLayout>

				<StackLayout Grid.Column="3" Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="Center">
					<Button Text="Go To Order" BackgroundColor="Red" Command="{Binding OpenOrderCommand}" Padding="5" />
				</StackLayout>
			</Grid>
		</Border>

		<ListView  ItemsSource="{Binding LGroups}">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="model:Group">
					<ViewCell>
						<Border>
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreateOrderVM}},Path=SelectCommand }" 
									CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>
							<Grid ColumnDefinitions="*,*">
								<!--<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:CreateOrderVM}},Path=SelectCommand }" 
										CommandParameter="{Binding .}"/> 
								</Grid.GestureRecognizers>-->
						
								<Image Grid.Column="0" Source="{Binding Gimage}" WidthRequest="100" HeightRequest="100"/>
								<Label Grid.Column="1" Text="{Binding Gname}"/>
							</Grid>
						</Border>
					</ViewCell>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</VerticalStackLayout>
</ContentPage>