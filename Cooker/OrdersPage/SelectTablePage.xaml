<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.OrdersPage.SelectTablePage"
             Title="SelectTablePage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to Select Table"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
		<Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" ColumnSpacing="20" RowSpacing="20" Margin="20">

			<Button Text="1" BackgroundColor="Red" Grid.Row="0" Grid.Column="0" FontSize="Medium" x:Name="btn1" Clicked="btn1_Clicked" />
			<Button Text="4" BackgroundColor="Red" Grid.Row="1" Grid.Column="0" FontSize="Medium" x:Name="btn4" Clicked="btn4_Clicked" />
			<Button Text="7" BackgroundColor="Red" Grid.Row="2" Grid.Column="0" FontSize="Medium" x:Name="btn7" Clicked="btn7_Clicked" />

			<Button Text="2" BackgroundColor="Red" Grid.Row="0" Grid.Column="1" FontSize="Medium" x:Name="btn2" Clicked="btn2_Clicked"/>
			<Button Text="5" BackgroundColor="Red" Grid.Row="1" Grid.Column="1" FontSize="Medium" x:Name="btn5" Clicked="btn5_Clicked"/>
			<Button Text="8" BackgroundColor="Red" Grid.Row="2" Grid.Column="1" FontSize="Medium" x:Name="btn8" Clicked="btn8_Clicked"/>

			<Button Text="3" BackgroundColor="Red" Grid.Row="0" Grid.Column="2" FontSize="Medium" x:Name="btn3" Clicked="btn3_Clicked"/>
			<Button Text="6" BackgroundColor="Red" Grid.Row="1" Grid.Column="2" FontSize="Medium" x:Name="btn6" Clicked="btn6_Clicked"/>
			<Button Text="9" BackgroundColor="Red" Grid.Row="2" Grid.Column="2" FontSize="Medium" x:Name="btn9" Clicked="btn9_Clicked"/>

		</Grid>
	</VerticalStackLayout>
</ContentPage>