<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cooker.MainPage">

	<Grid>
		<Image Aspect="Fill" Source="bg2.jpg" />
		<!--nested grid. OR StackLayout, etc.-->
		<Grid RowDefinitions="*,*"  Margin="100,180">
			<Label 
               Text="Welcome to Cookers"
               VerticalOptions="Center" 
               HorizontalOptions="Center" 
              TextColor="White"
              FontSize="26"/>
			<StackLayout Grid.Row="1" Margin="40,0" Spacing="20" >
				<Button x:Name="OrderBtn" Text="Order Now"  BackgroundColor="Red" Clicked="OrderBtn_Clicked"/>
				<Button x:Name="LoginBtn" Text="Login"  BackgroundColor="Red" Clicked="Button_Clicked"/>
				<Button x:Name="ChatBtn" Text="Chat"  BackgroundColor="Red" Clicked="ChatBtn_Clicked"/>
			</StackLayout>

		</Grid>
	</Grid>

</ContentPage>
